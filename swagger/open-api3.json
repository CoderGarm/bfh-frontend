              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      }
    },
    "/api/private/chat/{idUserOne}/{idUserTwo}": {
      "get": {
        "tags": [
          "ChatApi"
        ],
        "summary": "Get the chat history of the users and marks them as read",
        "description": "Get the chat between the users and marks them as read",
        "operationId": "getChatByUsers",
        "parameters": [
          {
            "name": "idUserOne",
            "in": "path",
            "description": "idUserOne",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "idUserTwo",
            "in": "path",
            "description": "idUserTwo",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatHistory"
                }
              },
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      }
    },
    "/api/private/chat/{idUser}": {
      "get": {
        "tags": [
          "ChatApi"
        ],
        "summary": "Get all active chats of the user without the messages",
        "description": "Get all active chats of the user without the messages",
        "operationId": "getChatByUser",
        "parameters": [
          {
            "name": "idUser",
            "in": "path",
            "description": "idUser",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatHistory"
                  }
                }
              },
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      }
    },
    "/api/private/user/": {
      "get": {
        "tags": [
          "UserApi"
        ],
        "summary": "Get the list of users",
        "description": "Get the list of users registered in the system",
        "operationId": "getAllUsers",
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserJson"
                  }
                }
              },
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      },
      "put": {
        "tags": [
          "UserApi"
        ],
        "summary": "Updates a single user",
        "description": "Updates and returns a user which is now registered in the system. Every changed field except the idUser will be updated. The user id must be present.",
        "operationId": "updateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserJson"
                }
              },
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      }
    },
    "/api/private/user/byNameLike/{username}": {
      "get": {
        "tags": [
          "UserApi"
        ],
        "summary": "Get a single user by it's idUser",
        "description": "Returns a list of users which usernames matches the search string",
        "operationId": "getUsersByLikeUserName",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "username",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserJson"
                  }
                }
              },
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      }
    },
    "/api/private/user/{idUser}": {
      "get": {
        "tags": [
          "UserApi"
        ],
        "summary": "Get a single user by it's idUser",
        "description": "Returns a user which is  registered in the system",
        "operationId": "getSingleUser",
        "parameters": [
          {
            "name": "idUser",
            "in": "path",
            "description": "idUser",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserJson"
                }
              },
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      },
      "delete": {
        "tags": [
          "UserApi"
        ],
        "summary": "Deletes a single user",
        "description": "Deletes a user which is not any longer registered in the system",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "idUser",
            "in": "path",
            "description": "idUser",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthRequest": {
        "title": "AuthRequest",
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "password": {
            "pattern": "((?=.*\\d)(?=.*[a-z])(?=.*[A-Z]).{8,30})",
            "type": "string"
          },
          "username": {
            "pattern": "[a-zA-Z0-9]{3,30}",
            "type": "string"
          }
        }
      },
      "ChatHistory": {
        "title": "ChatHistory",
        "required": [
          "messages",
          "userOne",
          "userTwo"
        ],
        "type": "object",
        "properties": {
          "idChatHistory": {
            "type": "integer",
            "description": "The id of this chat history",
            "format": "int32"
          },
          "messages": {
            "type": "array",
            "description": "The amount of messages.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "userOne": {
            "description": "One of the involved users.",
            "$ref": "#/components/schemas/UserJson"
          },
          "userTwo": {
            "description": "The other involved user.",
            "$ref": "#/components/schemas/UserJson"
          }
        }
      },
      "ChatMessage": {
        "title": "ChatMessage",
        "required": [
          "message",
          "sender",
          "sentAt"
        ],
        "type": "object",
        "properties": {
          "idUserMessage": {
            "type": "integer",
            "description": "The id of this message.",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "description": "The message itself"
          },
          "receivedAt": {
            "type": "string",
            "description": "The timestamp on which the message was read.",
            "format": "date-time"
          },
          "sender": {
            "description": "The message's sender.",
            "$ref": "#/components/schemas/UserJson"
          },
          "sentAt": {
            "type": "string",
            "description": "The timestamp on which the message was sent.",
            "format": "date-time"
          }
        }
      },
      "FrontendError": {
        "title": "FrontendError",
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The Error message."
          },
          "validationResults": {
            "type": "array",
            "description": "If it's not empty, some validation shows violations.",
            "items": {
              "$ref": "#/components/schemas/ValidationResult"
            }
          }
        }
      },
      "JWTReq": {
        "title": "JWTReq",
        "required": [
          "accessToken",
          "idUser",
          "refreshToken",
          "role",
          "username"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "The access token to authenticate every request against the backend."
          },
          "idUser": {
            "type": "integer",
            "description": "The user's ID.",
            "format": "int32"
          },
          "refreshToken": {
            "type": "string",
            "description": "The access token to authenticate every request against the backend."
          },
          "role": {
            "type": "string",
            "description": "The user's role.",
            "enum": [
              "USER"
            ]
          },
          "username": {
            "type": "string",
            "description": "The user's name."
          }
        }
      },
      "JWTRes": {
        "title": "JWTRes",
        "required": [
          "accessToken",
          "idUser",
          "refreshToken",
          "role",
          "username"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "The access token to authenticate every request against the backend."
          },
          "idUser": {
            "type": "integer",
            "description": "The user's ID.",
            "format": "int32"
          },
          "refreshToken": {
            "type": "string",
            "description": "The access token to authenticate every request against the backend."
          },
          "role": {
            "type": "string",
            "description": "The user's role.",
            "enum": [
              "USER"
            ]
          },
          "username": {
            "type": "string",
            "description": "The user's name."
          }
        }
      },
      "UserJson": {
        "title": "UserJson",
        "required": [
          "idUser",
          "username"
        ],
        "type": "object",
        "properties": {
          "idAlliance": {
            "type": "integer",
            "description": "The user's alliance.",
            "format": "int32"
          },
          "idUser": {
            "type": "integer",
            "description": "The user's database id.",
            "format": "int32"
          },
          "username": {
            "pattern": "[a-zA-Z0-9]{3,30}",
            "type": "string",
            "description": "The user's name"
          }
        }
      },
      "UserReq": {
        "title": "UserReq",
        "required": [
          "email",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "The user's e-mail - only shipped in a creation process"
          },
          "idAlliance": {
            "type": "integer",
            "format": "int32"
          },
          "idUser": {
            "type": "integer",
            "description": "The user's database id.",
            "format": "int32"
          },
          "password": {
            "pattern": "((?=.*\\d)(?=.*[a-z])(?=.*[A-Z]).{8,30})",
            "type": "string",
            "description": "The user's password - only shipped in a creation process"
          },
          "username": {
            "pattern": "[a-zA-Z0-9]{3,30}",
            "type": "string",
            "description": "The user's name"
          }
        }
      },
      "ValidationResult": {
        "title": "ValidationResult",
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "property": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "JWT": {
        "type": "apiKey",
        "name": "JWT",
        "in": "header"
      }
    }
  }
}
