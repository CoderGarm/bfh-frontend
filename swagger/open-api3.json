              }
            }
          },
          "400": {
            "description": "an error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendError"
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT": []
          }
        ]
      }
    },
    "/api/private/chat/sendMessage": {
      "put": {
        "tags": [
          "ChatApi"
        ],
        "summary": "Creates a chat message",
        "description": "Creates a chat message",
        "operationId": "sendChatMessage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful",
